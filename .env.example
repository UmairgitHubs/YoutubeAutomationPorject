# Copy to .env in the project root. Leave blank until you have official API credentials.

APP_NAME=Puzmania
HOST=127.0.0.1
PORT=8088

# Default true until YouTube / TikTok / Instagram credentials exist.
DRY_RUN=true

# Asia/Karachi matches the desk timezone.
TIMEZONE=Asia/Karachi
PUBLISH_TIME=09:00
EPISODES_PER_RUN=1
RETRY_ATTEMPTS=3
RETRY_BACKOFF=exponential

# YouTube Data API v3 (OAuth 2.0 — no service-account upload path)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public
# Optional. Must match an Authorized redirect URI on the Web OAuth client.
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:8088/api/auth/youtube/callback

# TikTok Content Posting API (Login Kit + Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
# Optional. Must match the Redirect URI registered on Login Kit.
# TikTok requires https. Use a tunnel URL if localhost http is rejected.
# TIKTOK_REDIRECT_URI=https://your-tunnel.example/api/auth/tiktok/callback

# Instagram Graph API — Professional (Business or Creator) account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# OpenAI (ChatGPT writes YouTube / Instagram / TikTok captions before each post)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public membership / competition site (shown on videos). Leave blank to use http://HOST:PORT/join
PUBLIC_SITE_URL=
JOIN_MIN_AGE=13

# Railway / production paths (local defaults work without these)
# HOST=0.0.0.0
# DATABASE_PATH=/data/puzmania.db
# EPISODES_DIR=/data/episodes
# LOG_DIR=/data/logs
# FRONTEND_DIR=/app/frontend
# YOUTUBE_REDIRECT_URI=https://YOUR-APP.up.railway.app/api/auth/youtube/callback

# Weekly winner card (prepended every N days). seed = random usernames; clicks = real members.
WINNER_MODE=seed
POINTS_MULTIPLIER=2500
WINNER_INTRO_DAYS=3
WINNER_POINTS_MIN=2000
WINNER_POINTS_MAX=5000

# Google Drive library (optional). The app copies episode folders onto this machine, then posts.
# 1. Enable Google Drive API on the same Google Cloud project.
# 2. Create a service account and download its JSON key.
# 3. Share your Drive folder (the parent of ALIEN_01, BLUR_01, …) with the service account email (Viewer).
# 4. Folder ID is the last part of https://drive.google.com/drive/folders/THIS_ID
GDRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_FILE=data/gdrive-sa.json
# Optional. If true, local episode folders missing from Drive are deleted after a successful sync.
GDRIVE_DELETE_MISSING=false

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SLACK_WEBHOOK_URL=
